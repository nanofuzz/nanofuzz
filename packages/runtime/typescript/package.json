{
  "name": "@nanofuzz/runtime",
  "displayName": "NaNofuzz runtime support",
  "publisher": "penrose",
  "version": "0.4.0",
  "description": "Runtime support and types for NaNofuzz",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanofuzz/nanofuzz.git",
    "directory": "packages/runtime/typescript"
  },
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/cjs/index.d.ts",
  "author": "The NaNofuzz Team @ Carnegie Mellon University",
  "license": "MIT",
  "scripts": {
    "checkver": "node checkVer.cjs",
    "prebuild": "node checkVer.cjs && node prebuild.cjs",
    "build": "npx tsc --project tsconfig.cjs.json && npx tsc --project tsconfig.esm.json",
    "package": "npm publish --dry-run --access public",
    "publish": "npm publish --access public",
    "lint": "npx eslint src",
    "pretest": "yarn lint && yarn build",
    "test": "node --no-experimental-strip-types ../../../node_modules/jasmine/bin/jasmine.js --config=jasmine.json"
  },
  "babel": {
    "presets": [
      "@babel/preset-typescript"
    ],
    "plugins": [
      [
        "@babel/plugin-transform-modules-commonjs",
        {
          "importInterop": "node"
        }
      ]
    ]
  },
  "files": [
    "build"
  ],
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "rimraf": "^5.0.5",
    "typescript": "^4.9.5"
  }
}

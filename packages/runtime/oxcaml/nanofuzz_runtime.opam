# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.4.0"
synopsis:
  "Runtime support and types for NaNofuzz test suites and property validators in OCaml/OxCaml"
description:
  "This package provides the runtime support and types necessary for NaNofuzz tests to be executed in OCaml/OxCaml projects."
maintainer: ["The NaNofuzz Team at Carnegie Mellon University"]
authors: ["The NaNofuzz Team at Carnegie Mellon University"]
license: "MIT"
homepage: "https://github.com/nanofuzz/nanofuzz"
bug-reports: "https://github.com/nanofuzz/nanofuzz/issues"
depends: [
  "ocaml" {>= "4.08.0"}
  "dune" {>= "2.9" & >= "2.9.0"}
  "yojson" {>= "1.6.0"}
  "msgpck" {>= "1.7"}
  "ounit2" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/nanofuzz/nanofuzz.git"

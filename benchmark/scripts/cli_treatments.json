{
  "description": "Factorial generator configuration benchmark for NaNofuzz CLI empirical study",
  "version": "1.0.0",
  "control": "R",
  "tasks": [
    "TreeValue",
    "DerivationTree",
    "parse",
    "_distance_norm",
    "make_def"
  ],
  "repetitions": 10,
  "replicates": 10,
  "runtimeMs": 180000,
  "warmup": {
    "enabled": true,
    "runsPerLane": 5,
    "runtimeMs": 15000
  },
  "randomSeed": "qwertonyuiop",
  "aiConfig": {
    "modelProvider": "gemini",
    "modelName": "gemini-3.8-flash",
    "modelTimeout": 30000
  },
  "treatments": {
    "SCRAM": {
      "name": "SCRAM",
      "description": "All generators active: Seed, Custom (User), Random, AI, Mutation",
      "generators": ["S", "C", "R", "A", "M"],
      "cliArgs": [
        "--model-provider",
        "gemini",
        "--model-name",
        "gemini-3.8-flash"
      ]
    },
    "S": {
      "name": "S",
      "description": "Seed generator only (saved tests)",
      "generators": ["S"],
      "cliArgs": [
        "--no-user-input-generator",
        "--no-random-input-generator",
        "--no-ai-input-generator",
        "--no-mutation-input-generator"
      ]
    },
    "SR": {
      "name": "SR",
      "description": "Seed and Random generators active",
      "generators": ["S", "R"],
      "cliArgs": [
        "--no-user-input-generator",
        "--no-ai-input-generator",
        "--no-mutation-input-generator"
      ]
    },
    "C": {
      "name": "C",
      "description": "Custom (User) generator only",
      "generators": ["C"],
      "cliArgs": [
        "--no-seed-input-generator",
        "--no-random-input-generator",
        "--no-ai-input-generator",
        "--no-mutation-input-generator"
      ]
    },
    "CR": {
      "name": "CR",
      "description": "Custom (User) and Random generators active",
      "generators": ["C", "R"],
      "cliArgs": [
        "--no-seed-input-generator",
        "--no-ai-input-generator",
        "--no-mutation-input-generator"
      ]
    },
    "R": {
      "name": "R",
      "description": "Random generator only (Control)",
      "generators": ["R"],
      "cliArgs": [
        "--no-seed-input-generator",
        "--no-user-input-generator",
        "--no-ai-input-generator",
        "--no-mutation-input-generator"
      ]
    },
    "A": {
      "name": "A",
      "description": "AI generator only",
      "generators": ["A"],
      "cliArgs": [
        "--model-provider",
        "gemini",
        "--model-name",
        "gemini-3.8-flash",
        "--no-seed-input-generator",
        "--no-user-input-generator",
        "--no-random-input-generator",
        "--no-mutation-input-generator"
      ]
    },
    "RA": {
      "name": "RA",
      "description": "Random and AI generators active",
      "generators": ["R", "A"],
      "cliArgs": [
        "--model-provider",
        "gemini",
        "--model-name",
        "gemini-3.8-flash",
        "--no-seed-input-generator",
        "--no-user-input-generator",
        "--no-mutation-input-generator"
      ]
    },
    "M": {
      "name": "M",
      "description": "Mutation generator only",
      "generators": ["M"],
      "cliArgs": [
        "--no-seed-input-generator",
        "--no-user-input-generator",
        "--no-random-input-generator",
        "--no-ai-input-generator"
      ]
    },
    "RM": {
      "name": "RM",
      "description": "Random and Mutation generators active",
      "generators": ["R", "M"],
      "cliArgs": [
        "--no-seed-input-generator",
        "--no-user-input-generator",
        "--no-ai-input-generator"
      ]
    },
    "RAM": {
      "name": "RAM",
      "description": "Random, AI, and Mutation generators active",
      "generators": ["R", "A", "M"],
      "cliArgs": [
        "--model-provider",
        "gemini",
        "--model-name",
        "gemini-3.8-flash",
        "--no-seed-input-generator",
        "--no-user-input-generator"
      ]
    },
    "SRM": {
      "name": "SRM",
      "description": "Seed, Random, and Mutation generators active",
      "generators": ["S", "R", "M"],
      "cliArgs": ["--no-user-input-generator", "--no-ai-input-generator"]
    },
    "CRM": {
      "name": "CRM",
      "description": "Custom, Random, and Mutation generators active",
      "generators": ["C", "R", "M"],
      "cliArgs": ["--no-seed-input-generator", "--no-ai-input-generator"]
    },
    "SRAM": {
      "name": "SRAM",
      "description": "Seed, Random, AI, and Mutation generators active (Custom disabled)",
      "generators": ["S", "R", "A", "M"],
      "cliArgs": [
        "--model-provider",
        "gemini",
        "--model-name",
        "gemini-3.8-flash",
        "--no-user-input-generator"
      ]
    },
    "CRAM": {
      "name": "CRAM",
      "description": "Custom, Random, AI, and Mutation generators active (Seed disabled)",
      "generators": ["C", "R", "A", "M"],
      "cliArgs": [
        "--model-provider",
        "gemini",
        "--model-name",
        "gemini-3.8-flash",
        "--no-seed-input-generator"
      ]
    }
  }
}

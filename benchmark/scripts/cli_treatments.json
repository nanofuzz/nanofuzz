{
  "description": "Factorial generator configuration benchmark for NaNofuzz CLI empirical study",
  "version": "1.0.0",
  "control": "R",
  "tasks": [
    "TreeValue",
    "DerivationTree",
    "parse",
    "_distance_norm",
    "make_def"
  ],
  "replicates": 10,
  "runtimeMs": 180000,
  "warmup": {
    "enabled": true,
    "runsPerLane": 3,
    "runtimeMs": 15000
  },
  "randomSeed": "qwertonyuiop",
  "aiConfig": {
    "modelProvider": "gemini",
    "modelName": "gemini-3.1-flash-lite",
    "modelTimeout": 30000
  },
  "treatments": {
    "SCRAM": {
      "name": "SCRAM",
      "description": "All generators active: Seed, Custom (User), Random, AI, Mutation",
      "generators": ["S", "C", "R", "A", "M"],
      "cliArgs": [
        "--model-provider", "gemini",
        "--model-name", "gemini-3.1-flash-lite",
        "--model-timeout", "30000"
      ]
    },
    "CR": {
      "name": "CR",
      "description": "Custom (User) and Random generators active",
      "generators": ["C", "R"],
      "cliArgs": [
        "--no-ai-input-generator",
        "--no-mutation-input-generator",
        "--no-seed-input-generator"
      ]
    },
    "R": {
      "name": "R",
      "description": "Random generator only",
      "generators": ["R"],
      "cliArgs": [
        "--no-ai-input-generator",
        "--no-mutation-input-generator",
        "--no-user-input-generator",
        "--no-seed-input-generator"
      ]
    },
    "RA": {
      "name": "RA",
      "description": "Random and AI generators active",
      "generators": ["R", "A"],
      "cliArgs": [
        "--model-provider", "gemini",
        "--model-name", "gemini-3.1-flash-lite",
        "--model-timeout", "30000",
        "--no-mutation-input-generator",
        "--no-user-input-generator",
        "--no-seed-input-generator"
      ]
    },
    "RM": {
      "name": "RM",
      "description": "Random and Mutation generators active",
      "generators": ["R", "M"],
      "cliArgs": [
        "--no-ai-input-generator",
        "--no-user-input-generator",
        "--no-seed-input-generator"
      ]
    },
    "SR": {
      "name": "SR",
      "description": "Seed and Random generators active",
      "generators": ["S", "R"],
      "cliArgs": [
        "--no-ai-input-generator",
        "--no-mutation-input-generator",
        "--no-user-input-generator"
      ]
    }
  }
}
